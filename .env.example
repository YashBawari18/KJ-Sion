# Thumbnail IQ Configuration

# Backend API Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_DIMENSION=1920

# Frontend Next.js Public URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional AI Explanation Provider (Stage C)
# If left blank, the system automatically falls back to the deterministic rule-based engine.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
